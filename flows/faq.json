{
  "name": "Demo FAQ bot",
  "start": "main",
  "keywords": {
    "hi": "main",
    "hello": "main",
    "hey": "main",
    "menu": "main",
    "start": "main",
    "help": "main"
  },
  "messages": {
    "fallback": "Sorry, I didn't understand that. Please tap one of the options, or type *menu*.",
    "unsupported": "I can only read text messages and button taps for now.",
    "error": "Something went wrong on our side. Please type *menu* to start again."
  },
  "nodes": {
    "main": {
      "type": "list",
      "text": "Welcome to *Global Development Network*!\nHow can we help you today? Tap *View topics* to choose.",
      "button": "View topics",
      "sectionTitle": "Topics",
      "options": [
        {
          "id": "about",
          "title": "About us",
          "description": "Who we are and what we do"
        },
        {
          "id": "contact",
          "title": "Contact & location",
          "description": "Phone, email and address"
        },
        {
          "id": "raise_ticket",
          "title": "Raise a ticket",
          "description": "Query, complaint or callback for our team"
        },
        {
          "id": "gdn_conference",
          "title": "Gdn conference",
          "description": "Global Development Network Conference Tokyo 2026"
        }
      ]
    },
    "callback_phone": {
      "type": "input",
      "text": "Sure {{contact_name}}! Which number should we call?\nType it with country code, e.g. +91 98765 43210.",
      "validate": "phone",
      "saveAs": "callback_phone",
      "next": "callback_date"
    },
    "callback_date": {
      "type": "input",
      "text": "On which date? Type it like 25/12/2026.",
      "validate": "date",
      "saveAs": "callback_date",
      "next": "callback_time"
    },
    "about": {
      "type": "buttons",
      "text": "*About us*\nThe *Global Development Network (GDN)* is a public international organisation that supports high-quality, policy-oriented social science research in Low- and Middle-Income Countries (LMICs) to promote better lives. We promote research on the premise that contextualised and locally driven research leads to more informed policies, increased policy ownership, better-informed implementation, and more sustainable and inclusive development choices. We also enable research capacity strengthening across countries and disciplines.\n\nFounded in 1999, GDN is currently headquartered in New Delhi, with a presence in Clermont-Ferrand, France and Washington D.C., United States.\n\nRepresentatives of Colombia, Egypt, India, Italy, Senegal and Sri Lanka signed an agreement establishing the Global Development Network. Download the full Charter.\nThe GDN International Assembly comprises six sovereign states - Colombia, Hungary, India, Spain, Sri Lanka and Fiji.",
      "options": [
        {
          "id": "main",
          "title": "Main menu"
        },
        {
          "id": "raise_ticket",
          "title": "Raise a ticket"
        }
      ]
    },
    "contact": {
      "type": "buttons",
      "text": "*Contact & location*\n📞 +91 00000 00000\n✉️ hello@example.com\n📍 Sample Street, Bengaluru",
      "options": [
        {
          "id": "main",
          "title": "Main menu"
        },
        {
          "id": "raise_ticket",
          "title": "Raise a ticket"
        }
      ]
    },
    "gdn_conference": {
      "type": "buttons",
      "text": "_https://conf2026.gdn.int_\n\n`Global Development Network Conference Tokyo 2026`\n\n",
      "options": [
        {
          "id": "main",
          "title": "Main menu"
        }
      ]
    },
    "ticket_done": {
      "type": "buttons",
      "text": "Thanks {{contact_name}}! Your ticket has been raised.\nReference ID: *{{reference_id}}*\nOur team will contact you soon.",
      "options": [
        {
          "id": "main",
          "title": "Main menu"
        }
      ]
    },
    "raise_ticket": {
      "type": "list",
      "text": "What would you like to raise?",
      "button": "Choose type",
      "sectionTitle": "Ticket type",
      "options": [
        {
          "id": "type_query",
          "title": "Query"
        },
        {
          "id": "type_complaint",
          "title": "Complaint"
        },
        {
          "id": "type_callback",
          "title": "Callback",
          "description": "We call you back on a day you choose"
        },
        {
          "id": "type_other",
          "title": "Other"
        }
      ]
    },
    "type_query": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "type": "Query"
      },
      "next": "raise_desk"
    },
    "type_complaint": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "type": "Complaint"
      },
      "next": "raise_desk"
    },
    "type_callback": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "type": "Callback"
      },
      "next": "callback_phone"
    },
    "type_other": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "type": "Other"
      },
      "next": "raise_desk"
    },
    "callback_time": {
      "type": "input",
      "text": "At what time? Type it like 14:30 or 2:30 pm.",
      "validate": "time",
      "saveAs": "callback_time",
      "next": "raise_desk"
    },
    "raise_desk": {
      "type": "list",
      "text": "Which team is this for?",
      "button": "Choose team",
      "sectionTitle": "Teams",
      "options": [
        {
          "id": "desk_travel",
          "title": "Travel",
          "description": "Tickets, flights and travel queries"
        },
        {
          "id": "desk_finance",
          "title": "Finance",
          "description": "Conference reimbursements"
        },
        {
          "id": "desk_logistic",
          "title": "Logistic",
          "description": "Hotel accommodation and local travel"
        },
        {
          "id": "desk_other",
          "title": "Other"
        }
      ]
    },
    "desk_travel": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "desk": "WA-Travel"
      },
      "next": "ticket_message"
    },
    "desk_finance": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "desk": "WA-Finance"
      },
      "next": "ticket_message"
    },
    "desk_logistic": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "desk": "WA-Logistic"
      },
      "next": "ticket_message"
    },
    "desk_other": {
      "type": "action",
      "action": "setTicket",
      "params": {
        "desk": "WA-Ticket"
      },
      "next": "ticket_message"
    },
    "ticket_message": {
      "type": "input",
      "text": "Please type your message in one message.\n(Type *menu* to go back.)",
      "saveAs": "ticket_message",
      "minLength": 5,
      "errorText": "Please type a bit more (at least 5 characters).",
      "next": "ticket_create"
    },
    "ticket_create": {
      "type": "action",
      "action": "createRequest",
      "next": "ticket_done",
      "onError": "ticket_failed"
    },
    "ticket_failed": {
      "type": "buttons",
      "text": "Sorry {{contact_name}}, we could not reach our team just now. Your request is saved on our side.\nReference ID: *{{reference_id}}*\nPlease keep this number when you contact us.",
      "options": [
        {
          "id": "main",
          "title": "Main menu"
        }
      ]
    }
  },
