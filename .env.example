# Copy this file to .env and fill in the values from your Meta app
# (developers.facebook.com > your app > WhatsApp > API Setup).
# & "C:\Program Files (x86)\cloudflared\cloudflared.exe" tunnel --url http://localhost:3000
# Permanent System User token (recommended) or the temporary token (expires in ~24h)
WHATSAPP_TOKEN=

# "Phone number ID" of the test number (NOT the phone number itself)
PHONE_NUMBER_ID=

# Any secret string you invent. Paste the same value in Meta > WhatsApp > Configuration > Verify token
VERIFY_TOKEN=change-me-to-a-random-string

# App secret (App settings > Basic). Required: it proves webhook calls really come from Meta.
APP_SECRET=

# Optional
GRAPH_API_VERSION=v23.0
PORT=3000
FLOW_FILE=flows/faq.json
SESSION_TTL_MINUTES=30

# Bot to Frappe, tickets: shared token sent in the ticket payload. Use the same value as
# whatsapp_ticket_token in Frappe's site_config.json, and a different value from FRAPPE_TO_BOT_TOKEN.
# Generate it the same way as FRAPPE_TO_BOT_TOKEN below. The method URL is in config/frappe.json.
FRAPPE_TOKEN=

# Bot to Frappe, sendMail action only: API key/secret of a dedicated bot user
# (User > Settings > API Access > Generate Keys), sent as "Authorization: token key:secret".
# Mail settings are in config/mail.json.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Frappe to bot: required shared token for POST /api/frappe/notify. Use the same value as
# whatsapp_bot_token in Frappe's site_config.json. Generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FRAPPE_TO_BOT_TOKEN=
