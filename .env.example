# Copy this file to .env and fill in the values from your Meta app
# (developers.facebook.com > your app > WhatsApp > API Setup).

# Permanent System User token (recommended) or the temporary token (expires in ~24h)
WHATSAPP_TOKEN=

# "Phone number ID" of the test number (NOT the phone number itself)
PHONE_NUMBER_ID=

# Any secret string you invent. Paste the same value in Meta > WhatsApp > Configuration > Verify token
VERIFY_TOKEN=change-me-to-a-random-string

# App secret (App settings > Basic). Used to check that webhook calls really come from Meta.
APP_SECRET=

# Optional
GRAPH_API_VERSION=v23.0
PORT=3000
FLOW_FILE=flows/faq.json
SESSION_TTL_MINUTES=30
